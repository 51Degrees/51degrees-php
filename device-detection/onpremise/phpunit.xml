<!-- Every PHP error, warning, notice and deprecation fails the run, as do
     risky tests. The attributes are those of PHPUnit 9.6, the version the
     build matrix runs. tests/bootstrap.php fails the run on a warning,
     notice or deprecation from a PHP the tests start. -->
<phpunit bootstrap="tests/bootstrap.php"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         convertDeprecationsToExceptions="true"
         failOnWarning="true"
         failOnRisky="true">
  <php>
    <!-- Report every level, whatever php.ini sets. -->
    <ini name="error_reporting" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="Unit">
      <file>tests/ReadOnlyTests.php</file>
      <file>tests/StoppedExampleFindOutMoreTests.php</file>
      <file>tests/DeviceDetectionTests.php</file>
      <file>tests/MetaDataTests.php</file>
      <file>tests/ExampleSettingsTests.php</file>
      <file>tests/SwigDataReadTests.php</file>
      <file>tests/StoredStringTests.php</file>
      <file>tests/EvidenceMapTests.php</file>
      <file>tests/ResourceCleanupTests.php</file>
      <file>tests/DataModelTests.php</file>
      <file>tests/NativeCallTests.php</file>
      <file>tests/ProfileIdsTests.php</file>
      <file>tests/PackagingTests.php</file>
      <file>tests/ReadTimingTests.php</file>
      <file>tests/ExampleTests.php</file>
      <file>tests/ExamplesWithoutSettingsTests.php</file>
      <file>tests/IniSettingsTests.php</file>
      <file>tests/LoadWithDlTests.php</file>
      <file>tests/StartWithoutDataFileTests.php</file>
      <file>tests/RequestTests.php</file>
      <file>tests/ExampleWebTests.php</file>
      <file>tests/UACHHashTests.php</file>
      <file>tests/EvidenceKeyCaseTests.php</file>
      <file>tests/RefreshDataTests.php</file>
      <file>tests/EnvironmentVariableTests.php</file>
      <file>tests/WebExampleReloadTests.php</file>
      <file>tests/ForkSafetyScriptTests.php</file>
      <file>tests/EvidenceRecordsTests.php</file>
      <file>tests/KeyFormatTests.php</file>
    </testsuite>
    <!-- The tests of the Unit suite that need no TAC data file, which
         ci/run-unit-tests.ps1 runs when the file is missing. They hold
         every test of the examples with no settings. -->
    <testsuite name="WithoutTacFile">
      <file>tests/MetaDataTests.php</file>
      <file>tests/ExampleSettingsTests.php</file>
      <file>tests/SwigDataReadTests.php</file>
      <file>tests/StoredStringTests.php</file>
      <file>tests/EvidenceMapTests.php</file>
      <file>tests/ResourceCleanupTests.php</file>
      <file>tests/ExamplesWithoutSettingsTests.php</file>
      <file>tests/IniSettingsTests.php</file>
      <file>tests/LoadWithDlTests.php</file>
      <file>tests/StartWithoutDataFileTests.php</file>
      <file>tests/RequestTests.php</file>
      <file>tests/EnvironmentVariableTests.php</file>
      <file>tests/WebExampleReloadTests.php</file>
      <file>tests/ForkSafetyScriptTests.php</file>
      <file>tests/EvidenceRecordsTests.php</file>
      <file>tests/KeyFormatTests.php</file>
    </testsuite>
    <!-- Downloads the free Lite data file from the distributor. Runs once,
         in .github/workflows/data-file-download.yml, and not in the build
         matrix, whose jobs take every free file from the asset cache. -->
    <testsuite name="Download">
      <file>tests/DownloadDataFileTests.php</file>
    </testsuite>
  </testsuites>
</phpunit>
