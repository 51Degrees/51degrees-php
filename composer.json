{
    "name": "51degrees/php-monorepo-dev",
    "type": "project",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        { "type": "path", "url": "./pipeline/core", "options": { "symlink": true, "versions": { "51degrees/fiftyone.pipeline.core": "4.x-dev" } } },
        { "type": "path", "url": "./pipeline/engines", "options": { "symlink": true, "versions": { "51degrees/fiftyone.pipeline.engines": "4.x-dev" } } },
        { "type": "path", "url": "./pipeline/cloudrequestengine", "options": { "symlink": true, "versions": { "51degrees/fiftyone.pipeline.cloudrequestengine": "4.x-dev" } } },
        { "type": "path", "url": "./pipeline/did", "options": { "symlink": true } },
        { "type": "path", "url": "./pipeline/did/owid-php", "options": { "symlink": true } },
        { "type": "path", "url": "./pipeline/translation", "options": { "symlink": true } },
        { "type": "path", "url": "./pipeline/derivedproperty", "options": { "symlink": true } },
        { "type": "path", "url": "./device-detection/cloud", "options": { "symlink": true } },
        { "type": "path", "url": "./location", "options": { "symlink": true } },
        { "type": "path", "url": "./ip-intelligence", "options": { "symlink": true } }
    ],
    "require": {
        "51degrees/fiftyone.pipeline.core": "@dev",
        "51degrees/fiftyone.pipeline.engines": "@dev",
        "51degrees/fiftyone.pipeline.cloudrequestengine": "@dev",
        "51degrees/fiftyone.pipeline.did": "@dev",
        "51degrees/fiftyone.pipeline.translation": "@dev",
        "51degrees/fiftyone.pipeline.derivedproperty": "@dev",
        "51degrees/fiftyone.devicedetection": "@dev",
        "51degrees/fiftyone.geolocation": "@dev",
        "51degrees/fiftyone.ipintelligence": "@dev",
        "phpunit/phpunit": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "fiftyone\\pipeline\\core\\tests\\": "pipeline/core/tests/",
            "fiftyone\\pipeline\\engines\\tests\\": "pipeline/engines/tests/",
            "fiftyone\\pipeline\\cloudrequestengine\\tests\\": "pipeline/cloudrequestengine/tests/",
            "fiftyone\\pipeline\\did\\tests\\": "pipeline/did/tests/",
            "fiftyone\\pipeline\\translation\\tests\\": "pipeline/translation/tests/",
            "fiftyone\\pipeline\\derivedproperty\\tests\\": "pipeline/derivedproperty/tests/",
            "fiftyone\\pipeline\\devicedetection\\tests\\": "device-detection/cloud/tests/",
            "fiftyone\\pipeline\\devicedetection\\examples\\cloud\\classes\\": "device-detection/cloud/examples/cloud/classes",
            "fiftyone\\pipeline\\geolocation\\tests\\": "location/tests/",
            "fiftyone\\pipeline\\geolocation\\examples\\cloud\\classes\\": "location/examples/cloud/classes/",
            "fiftyone\\pipeline\\ipintelligence\\tests\\": "ip-intelligence/tests/",
            "fiftyone\\pipeline\\ipintelligence\\examples\\classes\\": "ip-intelligence/examples/classes/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.39",
        "phpstan/phpstan": "^1.10"
    }
}
