parameters:
    phpVersion: 80000
    level: 6
    paths:
        - src
    # Some ignored patterns only match when the native SWIG extension is (not)
    # present, so do not fail when a pattern matches nothing.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # The on-premise engine and its data wrapper interact with classes that
        # are generated by SWIG at build time (EngineIpiSwig, ConfigIpiSwig,
        # ResultsIpiSwig, EvidenceIpiSwig, VectorStringSwig, ...). These are not
        # visible to static analysis, so the SWIG-typed properties, parameters
        # and return types cannot be given a checkable type.
        - '#has no type specified#'
        - '#with no type specified#'
        - '#has invalid return type .*Swig#'
        - '#unknown class .*Swig#'
        - '#class .*Swig not found#'
        - '#on an unknown class .*Swig#'
        - '#Call to (static )?method .* on an unknown class .*Swig#'
        - '#Call to function (extension_loaded|dl)\(\)#'
        # flowElementProperties is declared on CloudRequestEngine (accessed via
        # the pipeline's flow element list, typed as the base FlowElement).
        - '#undefined property fiftyone\\pipeline\\core\\FlowElement::\$flowElementProperties#'
