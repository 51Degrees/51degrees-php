<phpunit bootstrap="vendor/autoload.php">
  <testsuites>
    <!-- The unit suite runs against fixed cloud responses, so it needs no
         resource key and no network connection. It runs on every build,
         which is what makes a broken example show as red. -->
    <testsuite name="Unit">
      <file>tests/ReadOnlyTests.php</file>
      <file>tests/HardwareProfileCloudTest.php</file>
      <file>tests/DataModelTests.php</file>
      <file>tests/CloudPipelineOrderTests.php</file>
      <file>tests/EnvironmentVariableTests.php</file>
      <file>tests/ExamplesWithoutKeyTests.php</file>
      <file>tests/HumanConfidenceWebStandInTests.php</file>
      <file>tests/HardwareLookupStandInTests.php</file>
      <file>tests/HardwareLookupOutputTests.php</file>
      <file>tests/HighEntropyValuesExampleTests.php</file>
      <file>tests/WebExampleFlowDataTests.php</file>
      <file>tests/HardwareProfileDataTests.php</file>
      <file>tests/PublishedPackageTests.php</file>
      <file>tests/KeyFormatTests.php</file>
    </testsuite>
    <testsuite name="Integration">
      <file>tests/ExampleTests.php</file>
      <file>tests/DeviceDetectionTests.php</file>
      <file>tests/ExampleWebTests.php</file>
      <file>tests/HumanConfidenceWebTests.php</file>
      <file>tests/UACHCloudTests.php</file>
    </testsuite>
    <!-- The Human Confidence tests of what the staging cloud service serves
         and the production one does not. They read CLOUD_STAGING_ENDPOINT
         and RESOURCE_KEY_BESPOKE_STAGING, which only
         .github/workflows/cloud-human-confidence.yml sets, so only that
         workflow runs this suite. -->
    <testsuite name="Staging">
      <file>tests/HumanConfidenceWebStagingTests.php</file>
    </testsuite>
  </testsuites>
</phpunit>
