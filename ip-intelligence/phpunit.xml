<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheResult="false">
  <php>
    <env name="_51DEGREES_RESOURCE_KEY" value="!!YOUR_RESOURCE_KEY!!"/>
    <env name="_51DEGREES_CLOUD_ENDPOINT" value=""/>
    <env name="_51DEGREES_IPI_PATH" value=""/>
  </php>
  <testsuites>
    <!-- Runs everywhere: no native extension, data file or network needed. -->
    <testsuite name="Unit">
      <file>tests/SwigDataTests.php</file>
      <file>tests/ClientIpTests.php</file>
      <file>tests/ResourceCleanupTests.php</file>
      <file>tests/EnvironmentVariableTests.php</file>
      <file>tests/ExamplesUseStartupEngineTests.php</file>
      <file>tests/ExamplesWithoutKeyTests.php</file>
    </testsuite>
    <testsuite name="Integration">
      <file>tests/WebExamplesWithoutSettingsTests.php</file>
      <file>tests/IpIntelligenceCloudTests.php</file>
      <file>tests/IpIntelligenceOnPremiseTests.php</file>
      <file>tests/IpIntelligenceTranslationTests.php</file>
      <file>tests/ExampleTests.php</file>
      <file>tests/ExamplesWithoutSettingsTests.php</file>
    </testsuite>
  </testsuites>
</phpunit>
