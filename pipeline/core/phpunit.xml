<!-- Every PHP error, warning, notice and deprecation fails the run, as do
     risky and incomplete tests. The attributes are those of PHPUnit 9.6,
     the version the build matrix runs. tests/bootstrap.php fails the run
     on a warning, notice, deprecation or fatal error from a PHP the tests
     start, or one PHPUnit does not handle. -->
<phpunit bootstrap="tests/bootstrap.php"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         convertDeprecationsToExceptions="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnIncomplete="true">
  <php>
    <!-- Report every level, whatever php.ini sets. -->
    <ini name="error_reporting" value="-1"/>
  </php>
  <testsuites>
    <!-- Timed, so run only by ci/run-performance-tests.ps1. -->
    <testsuite name="Performance">
      <file>tests/JavaScriptBuilderPerformanceTests.php</file>
    </testsuite>
    <testsuite name="Unit">
      <file>tests/EveryFlowElementReadOnlyTests.php</file>
      <file>tests/ReadOnlyWebElementsTests.php</file>
      <file>tests/FinishedWritesTests.php</file>
      <file>tests/CoreTests.php</file>
      <file>tests/MultiPipelineElementTests.php</file>
      <file>tests/PipelineImmutableTests.php</file>
      <file>tests/ElementKeyTests.php</file>
      <file>tests/ExampleTests.php</file>
      <file>tests/JavaScriptBundlerTests.php</file>
      <file>tests/JavaScriptBuilderMinifyTests.php</file>
      <file>tests/JavaScriptBuilderMinifyChoicesTests.php</file>
      <file>tests/JavaScriptBuilderMinifyOnceTests.php</file>
      <file>tests/JsonBundlerListTests.php</file>
      <file>tests/JsonBundlerHumanConfidenceTests.php</file>
      <file>tests/JavaScriptBuilderParametersTests.php</file>
      <file>tests/JavaScriptBuilderObjectNameTests.php</file>
      <file>tests/JavaScriptBuilderSequenceTests.php</file>
      <file>tests/CallbackUrlTests.php</file>
      <file>tests/JsonBundlerWktTests.php</file>
      <file>tests/EnableCookiesTests.php</file>
      <file>tests/FlowDataTests.php</file>
      <file>tests/ElementDataListTests.php</file>
      <file>tests/FlowDataErrorsTests.php</file>
      <file>tests/DeprecatedDataKeyTests.php</file>
      <file>tests/CloseTests.php</file>
      <file>tests/PropertyDatabaseTests.php</file>
