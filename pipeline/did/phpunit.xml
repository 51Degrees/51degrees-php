<!-- Every PHP error, warning, notice and deprecation fails the run, as do
     PHPUnit's own warnings and deprecations and risky and incomplete
     tests, and the log names the test that raised each one. The package
     needs PHP 8.1, so its own PHPUnit is 10.5 or later, and the
     attributes are those of PHPUnit 10.5, which the later versions also
     take. tests/bootstrap.php fails the run on a warning, notice,
     deprecation or fatal error from a PHP the tests start, or one PHPUnit
     does not handle. -->
<phpunit bootstrap="tests/bootstrap.php"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitWarning="true"
         failOnRisky="true"
         failOnIncomplete="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnPhpunitDeprecations="true">
  <!-- The package's own code, which PHPUnit treats as first-party code. -->
  <source>
    <include>
      <directory>src</directory>
      <directory>examples</directory>
    </include>
  </source>
  <php>
    <!-- Report every level, whatever php.ini sets. -->
    <ini name="error_reporting" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="Unit">
      <file>tests/FodIdTest.php</file>
      <file>tests/DidClientTest.php</file>
      <file>tests/MaskedWarningTest.php</file>
      <file>tests/CreatorContextPageTest.php</file>
      <file>tests/EnvironmentVariableTest.php</file>
      <file>tests/ExamplesTest.php</file>
    </testsuite>
    <testsuite name="Live">
      <file>tests/DidClientLiveTest.php</file>
    </testsuite>
  </testsuites>
</phpunit>
